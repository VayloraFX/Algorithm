# Deriv OAuth Configuration
# Get these from https://deriv.com/app (if you have a Deriv account)
NEXT_PUBLIC_DERIV_CLIENT_ID="your_deriv_client_id"
NEXT_PUBLIC_DERIV_REDIRECT_URI="http://localhost:3000/callback"

# Deriv Environment: 'production' or 'preview'
# production: uses https://auth.deriv.com/oauth2
# preview: uses https://staging-auth.deriv.com/oauth2
NEXT_PUBLIC_DERIV_ENV="production"

# Gemini API Key for AI features
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL where this application is hosted
# Used for OAuth callbacks and API endpoints
APP_URL="http://localhost:3000"
